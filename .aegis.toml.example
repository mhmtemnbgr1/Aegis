# Aegis yapılandırma örneği.
# Kullanmak için: cp .aegis.toml.example .aegis.toml
# API anahtarları buraya YAZILMAZ; ortam değişkeni kullanın:
#   GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY

[llm]
provider = "ollama"              # ollama | gemini | openai | anthropic
model = "qwen2.5-coder:7b"
timeout_seconds = 30
temperature = 0.0

[budget]
max_input_tokens_per_request = 8000
max_total_tokens_per_push = 40000
max_requests_per_push = 6
chunking = "ast"                 # truncate | hunk | ast

[policy]
block_on_severity = "critical"
min_confidence = 0.8
verify_blocking_findings = true
fail_open = true

[filters]
max_changed_lines_per_file = 1500
languages = ["python", "typescript"]

[secrets]
enabled = true
entropy_threshold_base64 = 4.5
entropy_threshold_hex = 3.0
