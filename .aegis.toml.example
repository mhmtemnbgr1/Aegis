# Aegis yapılandırma örneği.
# Kullanmak için: cp .aegis.toml.example .aegis.toml
# API anahtarları buraya YAZILMAZ; ortam değişkeni kullanın:
#   GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY / GITHUB_TOKEN

[mining]
fix_patterns = ["fix", "bug", "regression", "leak", "crash", "hotfix"]
bug_issue_labels = ["bug"]
ignore_merge_commits = true
max_files_per_commit = 50        # daha büyük commit'ler SZZ'den elenir
label_delay_days = 180           # son N günün commit'leri eğitime alınmaz
szz_variant = "ma"               # ma (pyszz MA-SZZ) | b (PyDriller B-SZZ)
history_years = 5                # SZZ yalnızca son N yıla uygulanır

[gatekeeper]
mode = "heuristic"               # heuristic | model (model yoksa heuristic kullanılır)
model_path = ".aegis/model.lgbm"
low_threshold = 0.30             # altı: LLM çağrılmaz
high_threshold = 0.70            # üstü: tam zincir (analiz + patch + test)
# Eşikler yerine bütçe verilebilir:
# max_llm_pr_ratio = 0.4
explain = true                   # SHAP açıklaması

[gatekeeper.heuristic]
# Skor = ağırlıklı ortalama(boyut, riskli yol, riskli API); her bileşen 0–1 arası.
size_weight = 0.4
path_weight = 0.3
api_weight = 0.3
size_saturation = 400            # bu kadar değişen satırda boyut bileşeni 1 olur
api_saturation = 2               # bu kadar riskli API kullanımında API bileşeni 1 olur
# risky_paths = ["auth", "db", "payment", ...]       # yol kelimeleri (varsayılan listeyi değiştirir)
# risky_apis = ['\beval\(', '\bsubprocess\.', ...]   # eklenen satırlarda aranan regex'ler

[memory]
index_path = ".aegis/memory"
embedding_model = "local"        # local | openai
top_k = 3
retrieval = "hybrid"             # hybrid | vector | structural

[filters]
max_changed_lines_per_file = 1500
languages = ["python"]

[agents.analyst]
provider = "ollama"              # ollama | gemini | openai | anthropic
model = "qwen2.5-coder:7b"
temperature = 0.0                # anthropic'te yok sayılır
timeout_seconds = 60
# SDK'yı kurmak için: uv sync --extra <provider>  (ollama | gemini | openai | anthropic)
# Anahtarlar: GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY; Ollama adresi: OLLAMA_HOST
# Örnekler:
#   provider = "gemini"     model = "gemini-flash-latest"
#   provider = "anthropic"  model = "claude-opus-5-5"   effort = "medium"   # low | medium | high | xhigh | max

[agents.fixer]
provider = "ollama"
model = "qwen2.5-coder:7b"
max_retries = 2

[agents.tester]
provider = "ollama"
model = "qwen2.5-coder:7b"

[policy]
patch_min_severity = "high"      # bu seviye ve üstü için patch üretilir
patch_min_confidence = 0.7
fail_open = true

[verify]
sandbox = "docker"
timeout_seconds = 300
network = false
test_selection = "testmon"       # testmon | imports | all
parallel = true                  # pytest-xdist
max_patches_per_pr = 2

[review]
llm_enabled = true               # false: yalnızca gatekeeper + deterministik kurallar
language = "Turkish"             # bulgu ve özet dili
prompt_version = "v1"            # src/aegis/agents/prompts/<sürüm>
cache_dir = ".aegis/cache/llm"   # aynı istek ikinci kez API'ye gitmez
runs_path = ".aegis/runs.jsonl"  # çalıştırma metrikleri (FR-45)
# injection_exclude = ["docs/prompts/**"]  # injection dedektörünün atlayacağı yollar

[state]
release_tag = "aegis-state"      # aegis publish-state ile yüklenen arşivin release etiketi
use_actions_cache = true

[budget]
max_total_tokens_per_pr = 60000
max_llm_requests_per_pr = 12
